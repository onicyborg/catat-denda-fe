  "info": {
    "title": "EFMS API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "efms_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username atau email akun lama. Kirim tepat satu identifier."
          },
          "email": {
            "type": "string",
            "deprecated": true,
            "description": "Kompatibilitas akun lama; gunakan username untuk login baru."
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      },
      "PasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "AliasResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "aliasDisplay": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "aliasDisplay"
        ]
      },
      "EmployeeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "employeeCode": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "archivedAt": {
            "type": "string",
            "nullable": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AliasResponse"
            }
          }
        },
        "required": [
          "id",
          "displayName",
          "employeeCode",
          "isActive",
          "createdAt",
          "updatedAt",
          "archivedAt",
          "aliases"
        ]
      },
      "PageMetaResponse": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "EmployeesEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployeeResponse"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMetaResponse"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "EmployeeEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmployeeResponse"
          }
        },
        "required": [
          "data"
        ]
      },
      "EmployeeCreateDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "employeeCode": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "displayName"
        ]
      },
      "EmployeeUpdateDto": {
        "type": "object",
        "properties": {
          "displayName": {
